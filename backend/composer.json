{
    "require": {
        "slim/slim": "4.*",
        "slim/psr7": "^1.8",
        "stripe/stripe-php": "^14.0",
        "openai-php/client": "^0.10",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "classes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
